          "image_width": 116,
          "image_height": 54
        },
        {
          "type": "image",
          "image_path": "textures/gui/guide/chapters/fences/craft_iron_gate.png",
          "caption": "happyhallows.guide_book.chapters.blocks.craft_iron_gate_caption",
          "image_width": 116,
          "image_height": 54
        }
      ]
    },
    {
      "type": "standard",
      "summary": "Keep your questionable activities hidden from nosy neighbors with a Picket Fence. Gates and booby traps sold separately.",
      "elements": [
        {
          "type": "image",
          "image_path": "textures/gui/guide/chapters/fences/picket_fence.png",
          "caption": "happyhallows.guide_book.chapters.blocks.picket_fence_caption",
          "image_width": 116,
          "image_height": 68
        },
        {
          "type": "text",
          "literal_text": null,
          "text": "Picket Fences can be made from each type of Pine Planks, and are also found in MerryMaking."
        }
      ]
    },
